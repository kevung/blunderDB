{
  "_comment": "Shared search-query corpus (D.3, #203). Each case is an `s …`/`ss …` command plus the SearchFilters fields (long backend names, see searchFilterService.js's parseSearchTokens) it must parse to. Asserted on the JS side by frontend/src/__tests__/searchQueryCorpus.test.js against BOTH entry points of the grammar — the 'aller' path (commandProcessor.js's parseFilters, fed the same tokens the command bar itself derives) and the 'retour' path (searchFilterService.js's parseSearchCommand, used when SearchPanel replays a search-history or filter-library entry) — so the two can never again silently diverge (that divergence, for the xD/id/comment-presence fields, was the bug this corpus guards). `expected` only lists the fields a case is actually about; every other field keeps its default (false/''/undefined) and is not asserted. Reused, unmodified, by the future Go grammar package (B.18, pkg/blunderdb/searchquery) the same way testdata/xgid_corpus.json is shared with the Go XGID decoder.",
  "cases": [
    { "command": "s", "expected": {} },
    { "command": "s cube score d nc M i fl x", "expected": { "includeCube": true, "includeScore": true, "decisionTypeFilter": true, "noContactFilter": true, "mirrorPositionFilter": true, "individuallyImportedFilter": true, "flaggedFilter": true, "excludeStructure": true } },
    { "command": "s D", "expected": { "diceRollFilter": true, "diceRollMode": "both" } },
    { "command": "s D1", "expected": { "diceRollFilter": true, "diceRollMode": "first" } },
    { "command": "s D xD65", "expected": { "diceRollFilter": true, "diceRollMode": "both", "exceptDiceFilter": "65" } },
    { "command": "s xD65 xD54", "expected": { "exceptDiceFilter": "65;54" } },
    { "command": "s xD70 xD6 xD655", "expected": { "exceptDiceFilter": "" } },
    { "command": "s co", "expected": { "commentFilter": "has" } },
    { "command": "s xco", "expected": { "commentFilter": "none" } },
    { "command": "s p>30", "expected": { "pipCountFilter": "p>30" } },
    { "command": "s p<10", "expected": { "pipCountFilter": "p<10" } },
    { "command": "s p5,20", "expected": { "pipCountFilter": "p5,20" } },
    { "command": "s w>50 W<40", "expected": { "winRateFilter": "w>50", "player2WinRateFilter": "W<40" } },
    { "command": "s b>5 bo3,5 bj2,4", "expected": { "backgammonRateFilter": "b>5", "player1OutfieldBlotFilter": "bo3,5", "player1JanBlotFilter": "bj2,4" } },
    { "command": "s B>2 BO3,5 BJ1,2", "expected": { "player2BackgammonRateFilter": "B>2", "player2OutfieldBlotFilter": "BO3,5", "player2JanBlotFilter": "BJ1,2" } },
    { "command": "s o5", "expected": { "player1CheckerOffFilter": "o5,5" } },
    { "command": "s o3,8", "expected": { "player1CheckerOffFilter": "o3,8" } },
    { "command": "s o>3", "expected": { "player1CheckerOffFilter": "o>3" } },
    { "command": "s K3", "expected": { "player2BackCheckerFilter": "K3,3" } },
    { "command": "s z2", "expected": { "player1CheckerInZoneFilter": "z2,2" } },
    { "command": "s P>100", "expected": { "player1AbsolutePipCountFilter": "P>100" } },
    { "command": "s e-0.3,0.5", "expected": { "equityFilter": "e-0.3,0.5" } },
    { "command": "s E>0.05", "expected": { "moveErrorFilter": "E>0.05" } },
    { "command": "s T>2026/01/01", "expected": { "dateFilter": "T>2026/01/01" } },
    { "command": "s ma1 ma2 ma3", "expected": { "matchIDsFilter": "1;2;3" } },
    { "command": "s tn10 tn20", "expected": { "tournamentIDsFilter": "10;20" } },
    { "command": "s id5,10", "expected": { "positionIDsFilter": "5,10" } },
    { "command": "s id5 id10 id15", "expected": { "positionIDsFilter": "5;10;15" } },
    { "command": "s t\"big win\"", "expected": { "searchText": "t\"big win\"" } },
    { "command": "s m\"24/18 13/11\"", "expected": { "movePatternFilter": "m\"24/18 13/11\"" } },
    { "command": "s pl\"Kévin Unger\" p>120", "expected": { "playerFilter": "pl\"Kévin Unger\"", "pipCountFilter": "p>120" } },
    { "command": "s cube p>30 w>50 E>0.05 nc", "expected": { "includeCube": true, "pipCountFilter": "p>30", "winRateFilter": "w>50", "moveErrorFilter": "E>0.05", "noContactFilter": true } },
    { "command": "s ph:race", "expected": { "gamePhaseFilter": "race" } },
    { "command": "s ph:race ph:bearoff", "expected": { "gamePhaseFilter": "race;bearoff" } },
    { "command": "s ph:opening p>30", "expected": { "gamePhaseFilter": "opening", "pipCountFilter": "p>30" } },
    { "command": "s #prime", "expected": { "tagFilter": "#prime" } },
    { "command": "s #prime #backgame", "expected": { "tagFilter": "#prime;#backgame" } },
    { "command": "s #Prime", "expected": { "tagFilter": "#prime" } },
    { "command": "s #prime ph:race", "expected": { "tagFilter": "#prime", "gamePhaseFilter": "race" } },
    { "command": "s co:user", "expected": { "commentOriginFilter": "user" } },
    { "command": "s co co:xg", "expected": { "commentFilter": "has", "commentOriginFilter": "xg" } }
  ]
}
