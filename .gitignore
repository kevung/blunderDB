# Single-instance lock next to the database file (database/db.go: path + ".lock").
# Not covered by *.db, so it used to show up as untracked next to every database
# opened at the repo root — and once slipped into a commit.
*.db.lock

messages.mo

# Claude Code scheduler runtime lock (local, transient)
.claude/scheduled_tasks.lock

# Claude Code personal overrides (per-machine; the shared config is settings.json)
.claude/settings.local.json
# Root-level build output only (`go build .`) — unanchored "blunderdb" also
# matched the pkg/blunderdb/ directory name, silently hiding any new
# untracked file added under it from `git add`.
/blunderdb
gnubg_ts6x11.bd
*.bd.part

# Python virtualenvs for the Sphinx toolchain (doc/requirements.txt), at the
# root or under doc/ — sphinx-build is not on the system PATH, so each machine
# creates its own.
.venv/
doc/.venv/

# Compiled test binaries (`go test -c -o <name>.test`). Nothing builds or reads
# them; they are throwaway profiling tools. One (tmp_perf.test, 13.4 MB) reached
# 0.32.0 and shipped in every clone of the module before being removed.
*.test

# Browser "Save page as" output (e.g. a saved GnuBG Bot Match Report page),
# dropped under testdata/ by hand while investigating an issue. Not a fixture
# anything reads.
testdata/Match Report*
