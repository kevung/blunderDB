# Dockerfile.serve — headless blunderDB engine (HTTP + JSON daemon).
#
# Builds ONLY the `serve` binary via ./cmd/serve: pure Go, no Wails, no Node,
# no embedded frontend. The SQLite backend uses the pure-Go modernc.org/sqlite
# driver, so the binary builds with CGO disabled and links statically.
#
# Generic & Desktop-friendly: this image runs the same engine the Desktop app
# embeds, just headless. It performs NO authentication — run it behind an
# authenticating reverse-proxy (e.g. gammonGo) and never expose it publicly.

# --- build stage ---------------------------------------------------------
# Pinned to the *build* platform: the compiler always runs natively and Go
# cross-compiles for TARGETOS/TARGETARCH (set by BuildKit per requested
# platform), so a `docker buildx build --platform linux/amd64,linux/arm64`
# never emulates a Go toolchain under QEMU. BuildKit predefines BUILDPLATFORM;
# the deprecated legacy builder (`docker build` without buildx) does not and
# would fail on an empty --platform, hence the linux/amd64 fallback — a
# Dockerfile ARG default replaces the predefined value, which is why the
# fallback goes through ${VAR:-default} rather than a plain default. Under
# the legacy builder TARGETOS/TARGETARCH stay empty, which Go reads as the
# host platform.
ARG BUILDPLATFORM=${BUILDPLATFORM:-linux/amd64}
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
WORKDIR /src

# Cache module downloads.
COPY go.mod go.sum ./
RUN go mod download

# Build the headless serve binary.
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/blunderdb ./cmd/serve

# /data is the conventional mount point for a SQLite backend
# (BLUNDERDB_BACKEND=sqlite BLUNDERDB_DSN=/data/blunderdb.db). Created here,
# owned by distroless's nonroot uid/gid (65532), so a fresh named volume
# mounted there inherits writable ownership instead of root's.
RUN mkdir -p /out/data && chown 65532:65532 /out/data

# --- runtime stage -------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/blunderdb /usr/local/bin/blunderdb
COPY --from=build --chown=65532:65532 /out/data /data
# The image is a distributed copy of the binary: the MIT notices of what it
# links (pgx, modernc sqlite, Strehl network…) travel with it.
COPY --from=build /src/LICENSE /src/THIRD_PARTY.md /usr/share/doc/blunderdb/

# Defaults; override via env (BLUNDERDB_BACKEND/DSN/ADDR/RLS) in compose.
ENV BLUNDERDB_BACKEND=postgres \
    BLUNDERDB_ADDR=:8080
EXPOSE 8080

# Readiness probe: the binary's own `healthcheck` subcommand does one GET on
# /readyz (storage reachable, schema current) at BLUNDERDB_ADDR — distroless
# ships no curl or wget. Exec form on purpose: there is no shell either.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD ["/usr/local/bin/blunderdb", "healthcheck"]

ENTRYPOINT ["/usr/local/bin/blunderdb"]
