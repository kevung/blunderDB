{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/ tests/ *.config.js",
    "lint:fix": "eslint src/ tests/ *.config.js --fix",
    "format": "prettier --write src/ tests/ *.config.js",
    "format:check": "prettier --check src/ tests/ *.config.js",
    "check:svelte-warnings": "node scripts/check-svelte-warnings.mjs",
    "check:e2e-flaky": "node scripts/check-e2e-flaky.mjs",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "check:types": "node scripts/check-svelte-types.mjs",
    "build:web": "vite build --config vite.web.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "two.js": "^0.8.24"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
