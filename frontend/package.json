{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/ tests/ *.config.js",
    "lint:fix": "eslint src/ tests/ *.config.js --fix",
    "format": "prettier --write src/ tests/ *.config.js",
    "format:check": "prettier --check src/ tests/ *.config.js",
    "check:svelte-warnings": "node scripts/check-svelte-warnings.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.55.0",
    "svelte-eslint-parser": "^1.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "driver.js": "^1.8.0",
    "two.js": "^0.8.14"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
