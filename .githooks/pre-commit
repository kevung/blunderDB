#!/usr/bin/env bash
# Versioned pre-commit hook, incremental: it looks at the staged files only.
# Wire it in once per clone with `make setup` (git config core.hooksPath .githooks).
#   Go:       gofmt, go vet and go test -short on the touched packages
#   Frontend: eslint and prettier --check on the staged files, plus the
#             Svelte warnings budget when a .svelte file is staged
#   Help:     the in-app help bundles are rendered from the docs; a staged
#             .rst, .po or help prose fragment re-checks they are current
# Nothing relevant staged, nothing run. The full loop is `make check`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#staged[@]} -eq 0 ] && exit 0

go_files=(); front_files=(); svelte=0; help_src=0
for f in "${staged[@]}"; do
  case "$f" in
    doc/source/*.rst|doc/source/locale/*.po|frontend/src/i18n/help/*|frontend/public/help/*) help_src=1 ;;
  esac
  case "$f" in
    frontend/wailsjs/*|frontend/dist/*) ;;
    *.go) go_files+=("$f") ;;
    frontend/*.js|frontend/*.mjs|frontend/*.svelte|frontend/*.json|frontend/*.css)
      # package*.json are written by npm (2 spaces) and outside format:check.
      case "$f" in frontend/node_modules/*|frontend/package.json|frontend/package-lock.json) continue ;; esac
      front_files+=("${f#frontend/}")
      [[ "$f" == *.svelte ]] && svelte=1 ;;
  esac
done

if [ ${#go_files[@]} -gt 0 ]; then
  # main.go embeds frontend/dist, absent from a fresh checkout or worktree.
  if [ ! -e frontend/dist ]; then mkdir -p frontend/dist && touch frontend/dist/.gitkeep; fi
  bad="$(gofmt -l "${go_files[@]}")"
  if [ -n "$bad" ]; then
    echo "gofmt: not clean (run: gofmt -w):" >&2; echo "$bad" >&2; exit 1
  fi
  pkgs=()
  while IFS= read -r d; do pkgs+=("./$d"); done < <(
    for f in "${go_files[@]}"; do dirname "$f"; done | sort -u |
      while read -r d; do [ -d "$d" ] && ls "$d"/*.go >/dev/null 2>&1 && echo "$d"; done)
  pkgs=("${pkgs[@]/#.\/./.}")
  if [ ${#pkgs[@]} -gt 0 ]; then
    echo "pre-commit: go vet + go test -short on ${pkgs[*]}"
    go vet "${pkgs[@]}"
    out="$(mktemp)"; trap 'rm -f "$out"' EXIT
    if ! go test -short -count=1 "${pkgs[@]}" >"$out" 2>&1; then
      grep -Ev '^(ok|\?) ' "$out" | head -60 >&2; exit 1
    fi
  fi
fi

if [ ${#front_files[@]} -gt 0 ]; then
  # A fresh worktree has no node_modules: link the main checkout's.
  if [ ! -e frontend/node_modules ]; then
    main_root="$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")"
    if [ -d "$main_root/frontend/node_modules" ]; then
      ln -s "$main_root/frontend/node_modules" frontend/node_modules
      echo "pre-commit: frontend/node_modules linked from $main_root" >&2
    fi
  fi
  if [ ! -e frontend/node_modules ]; then
    echo "pre-commit: frontend/node_modules absent and no main checkout to link: run npm ci in frontend/" >&2
    exit 1
  else
    echo "pre-commit: eslint + prettier on ${#front_files[@]} frontend file(s)"
    (cd frontend && npx eslint "${front_files[@]}" && npx prettier --check "${front_files[@]}")
    if [ "$svelte" -eq 1 ]; then
      (cd frontend && npm run --silent check:svelte-warnings)
    fi
  fi
fi

if [ "$help_src" -eq 1 ]; then
  if [ ! -e frontend/dist ]; then mkdir -p frontend/dist && touch frontend/dist/.gitkeep; fi
  echo "pre-commit: help bundles against the docs they render"
  if ! go test -count=1 -run 'TestHelpBundlesAreCurrent' ./cmd/help-gen >/dev/null 2>&1; then
    echo "pre-commit: help bundles out of date (run: make help, then stage frontend/public/help/)" >&2
    exit 1
  fi
fi
