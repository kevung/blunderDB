{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "git",
        "url": "https://github.com/mattpocock/skills.git"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/budget.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/budget.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
