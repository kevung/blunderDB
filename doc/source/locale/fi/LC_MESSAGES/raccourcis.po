#: ../../source/raccourcis.rst:1
msgid "Évaluer : Difficile."
msgstr "Arvioi: Vaikea."

#: ../../source/raccourcis.rst:1
msgid "3"
msgstr "3"

#: ../../source/raccourcis.rst:1
msgid "Évaluer : Bien."
msgstr "Arvioi: Hyvä."

#: ../../source/raccourcis.rst:1
msgid "4"
msgstr "4"

#: ../../source/raccourcis.rst:1
msgid "Évaluer : Facile."
msgstr "Arvioi: Helppo."

#: ../../source/raccourcis.rst:1
msgid ""
"Afficher/cacher le compte de course (identique au raccourci général, "
"disponible pendant la révision)."
msgstr ""
"Näytä/piilota pip-laskuri (sama kuin yleinen pikanäppäin, käytettävissä "
"kertauksen aikana)."

#: ../../source/raccourcis.rst:1
msgid "Arrêter la révision et revenir à la liste des paquets (reprise possible)."
msgstr "Lopeta kertaus ja palaa pakkaluetteloon (voidaan jatkaa myöhemmin)."

#: ../../source/raccourcis.rst:295
msgid "Panneau des tournois"
msgstr "Turnauspaneeli"

#: ../../source/raccourcis.rst:1
msgid "Clic, Double-clic"
msgstr "Napsautus, Kaksoisnapsautus"

#: ../../source/raccourcis.rst:1
msgid "Sélectionner un tournoi (afficher son détail)."
msgstr "Valitse turnaus (näytä sen tiedot)."

#: ../../source/raccourcis.rst:1
msgid "Sélectionner le tournoi précédent."
msgstr "Valitse edellinen turnaus."

#: ../../source/raccourcis.rst:1
msgid "Sélectionner le tournoi suivant."
msgstr "Valitse seuraava turnaus."

#: ../../source/raccourcis.rst:1
msgid "Double-clic (sur un match du tournoi)"
msgstr "Kaksoisnapsautus (turnauksen ottelun kohdalla)"

#: ../../source/raccourcis.rst:1
msgid ""
"Annuler l'édition en cours, sinon effacer la recherche d'ajout de match, "
"sinon désélectionner le tournoi, sinon fermer le panneau (par paliers)."
msgstr ""
"Peruuta käynnissä oleva muokkaus, muuten tyhjennä ottelun lisäyshaku, "
"muuten poista turnauksen valinta, muuten sulje paneeli (askel "
"kerrallaan)."

#: ../../source/raccourcis.rst:311
msgid "Panneau des collections"
msgstr "Kokoelmapaneeli"

#: ../../source/raccourcis.rst:1
msgid "Ajouter/retirer la position courante de la collection survolée."
msgstr ""
"Lisää nykyinen asema osoittimen alla olevaan kokoelmaan tai poista se "
"siitä."

#: ../../source/raccourcis.rst:1
msgid "Ouvrir la collection."
msgstr "Avaa kokoelma."

#: ../../source/raccourcis.rst:1
msgid ""
"Retirer la position courante (ou les positions cochées) de la collection "
"ouverte."
msgstr "Poista nykyinen asema (tai valitut asemat) avoimesta kokoelmasta."

#: ../../source/raccourcis.rst:1
msgid ""
"Revenir à la liste des collections, sinon désélectionner la collection, "
"sinon fermer le panneau (par paliers)."
msgstr ""
"Palaa kokoelmalistaan, muuten poista kokoelman valinta, muuten sulje "
"paneeli (askel kerrallaan)."

#: ../../source/raccourcis.rst:325
msgid ""
"Ce panneau ne capture pas les raccourcis de navigation : PageUp/h, "
"GAUCHE/k, DROITE/j, PageDown/l naviguent dans les positions de la "
"collection ouverte exactement comme décrit dans "
":ref:`raccourcis_navigation`."
msgstr ""
"Tämä paneeli ei kaappaa navigointipikanäppäimiä: PageUp/h, VASEN/k, "
"OIKEA/j, PageDown/l liikkuvat avoimen kokoelman asemissa täsmälleen kuten"
" kohdassa :ref:`raccourcis_navigation` kuvataan."

