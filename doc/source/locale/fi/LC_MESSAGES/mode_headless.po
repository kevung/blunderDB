msgstr "``100``"

#: ../../source/mode_headless.rst:139
msgid "taille du seau de jetons pour les pics de requêtes"
msgstr "token-ämpärin koko pyyntöpiikkejä varten"

#: ../../source/mode_headless.rst:140
msgid "``--rls``"
msgstr "``--rls``"

#: ../../source/mode_headless.rst:142
