#~ msgstr "events — Die Schreibweisen einer Veranstaltung"

#~ msgid ""
#~ "Les mêmes actions que ``players alias``,"
#~ " pour les noms d'événement (le champ"
#~ " Event d'un fichier). À l'import, un"
#~ " match dont l'événement est un alias"
#~ " est rangé dans le tournoi du "
#~ "nom canonique."
#~ msgstr ""
