#: ../../source/cli.rst:1
msgid "training"
msgstr "training"

#: ../../source/cli.rst:1
msgid "Le journal d'entraînement (séances, positions manquées)."
msgstr "Das Trainingsprotokoll (Sitzungen, verfehlte Stellungen)."

#: ../../source/cli.rst:1
msgid "comment"
msgstr "comment"

#: ../../source/cli.rst:1
msgid "Lit et ajoute les commentaires d'une position, attribués à leur auteur."
msgstr ""
"Liest und fügt die Kommentare einer Stellung hinzu, zugeordnet ihrem "
"Autor."

#: ../../source/cli.rst:1
msgid "elsewhere"
msgstr "elsewhere"

#: ../../source/cli.rst:1
msgid "Ce que d'autres bases savent d'une position, et ses voisines chez elles."
msgstr "Was andere Datenbanken über eine Stellung wissen, und ihre Nachbarn dort."

#: ../../source/cli.rst:1
msgid "cubematrix"
msgstr "cubematrix"

