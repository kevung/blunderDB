msgstr "Zeigt die Positionen und Analysen eines Matches an."

#: ../../source/cli.rst:1
msgid "transcribe"
msgstr "transcribe"

#: ../../source/cli.rst:1
msgid "Rejoue une transcription et rend compte de ce que le rejeu trouve."
msgstr ""
"Spielt eine Transkription erneut ab und berichtet, was das Abspielen "
"findet."

#: ../../source/cli.rst:1
msgid "duel"
msgstr "duel"

#: ../../source/cli.rst:1
msgid ""
"Joue un Duel une Action par appel (création, coup, videau, abandon, "
"arrêt)."
msgstr ""
"Spielt ein Duell, eine Aktion pro Aufruf (Erstellung, Zug, Doppler, "
"Aufgabe, Beenden)."

#: ../../source/cli.rst:1
msgid "collection"
msgstr "collection"

#: ../../source/cli.rst:1
msgid ""
"Gère les collections (liste, contenu, création, renommage, suppression, "
"export)."
msgstr ""
"Verwaltet Sammlungen (Liste, Inhalt, Erstellung, Umbenennung, Löschung, "
