#: ../../source/cli.rst:1
msgid "search"
msgstr "search"

#: ../../source/cli.rst:1
msgid "Recherche des positions avec filtres."
msgstr "Sucht Positionen mit Filtern."

#: ../../source/cli.rst:1
msgid "list"
msgstr "list"

#: ../../source/cli.rst:1
msgid "Affiche le contenu de la base."
msgstr "Zeigt den Inhalt der Datenbank an."

#: ../../source/cli.rst:1
msgid "match"
msgstr "match"

