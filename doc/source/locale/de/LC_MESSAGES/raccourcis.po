msgid "Afficher/cacher le panneau des matchs."
msgstr "Das Match-Fenster ein-/ausblenden."

#: ../../source/raccourcis.rst:1
msgid "CTRL-B"
msgstr "STRG-B"

#: ../../source/raccourcis.rst:1
msgid "Afficher/cacher le panneau des collections."
msgstr "Das Sammlungen-Fenster ein-/ausblenden."

#: ../../source/raccourcis.rst:1
msgid "CTRL-Y"
msgstr "STRG-Y"

#: ../../source/raccourcis.rst:1
msgid "Afficher/cacher le panneau des tournois."
msgstr "Das Turnier-Fenster ein-/ausblenden."

#: ../../source/raccourcis.rst:1
msgid "CTRL-D"
msgstr "STRG-D"

#: ../../source/raccourcis.rst:1
msgid "Afficher/cacher le panneau Stats."
msgstr "Das Statistik-Fenster ein-/ausblenden."

#: ../../source/raccourcis.rst:1
msgid "CTRL-E"
msgstr "STRG-E"

#: ../../source/raccourcis.rst:1
msgid "Afficher/cacher le panneau Eval."
msgstr "Das Eval-Panel ein-/ausblenden."

#: ../../source/raccourcis.rst:1
msgid "CTRL-MAJ-T"
msgstr "STRG-UMSCHALT-T"

#: ../../source/raccourcis.rst:1
msgid "Afficher/cacher le panneau Transcription (brouillons de matchs)."
msgstr "Das Transkriptions-Panel ein-/ausblenden (Match-Entwürfe)."

#: ../../source/raccourcis.rst:1
msgid "?"
msgstr "?"

