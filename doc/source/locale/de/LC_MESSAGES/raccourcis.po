msgid "Copier l'image du board avec l'analyse dans le presse-papier (PNG)."
msgstr "Das Bild des Boards mit Analyse in die Zwischenablage kopieren (PNG)."

#: ../../source/raccourcis.rst:1
msgid "CTRL-V"
msgstr "STRG-V"

#: ../../source/raccourcis.rst:1
msgid ""
"Coller une position depuis le presse-papier (détection automatique du "
"format)."
msgstr ""
"Eine Position aus der Zwischenablage einfügen (automatische "
"Formaterkennung)."

#: ../../source/raccourcis.rst:1
msgid "CTRL-S"
msgstr "STRG-S"

#: ../../source/raccourcis.rst:1
msgid "Enregistrer une position."
msgstr "Eine Position speichern."

#: ../../source/raccourcis.rst:1
msgid "CTRL-U"
msgstr "STRG-U"

#: ../../source/raccourcis.rst:1
msgid "Mettre à jour une position."
msgstr "Eine Position aktualisieren."

#: ../../source/raccourcis.rst:1
msgid "Del"
msgstr "Entf"

