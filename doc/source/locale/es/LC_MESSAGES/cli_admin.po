msgstr "**Opciones:**"

#: ../../source/cli_admin.rst:17 ../../source/cli_admin.rst:104
#: ../../source/cli_admin.rst:138 ../../source/cli_admin.rst:274
#: ../../source/cli_admin.rst:319 ../../source/cli_admin.rst:359
