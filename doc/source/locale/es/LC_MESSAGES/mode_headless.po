msgid "``50``"
msgstr "``50``"

#: ../../source/mode_headless.rst:103
msgid ""
"limite de requêtes par seconde et par tenant (0 = désactivé) ; activée "
"par défaut à une valeur généreuse plutôt que sur option, pour qu'un "
"fichier compose qui ne pense qu'à la base de données n'hérite pas d'un "
"démon sans aucune limite"
msgstr ""
"límite de peticiones por segundo y por tenant (0 = desactivado); activado"
" por defecto con un valor generoso en lugar de opcional, para que un "
"fichero compose que solo piensa en la base de datos no herede un demonio "
"sin ningún límite"

#: ../../source/mode_headless.rst:107
