msgstr "Muestra las posiciones y los análisis de una partida."

#: ../../source/cli.rst:1
msgid "transcribe"
msgstr "transcribe"

#: ../../source/cli.rst:1
msgid "Rejoue une transcription et rend compte de ce que le rejeu trouve."
msgstr "Reproduce una transcripción e informa de lo que encuentra la reproducción."

