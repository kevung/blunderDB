#: ../../source/cli.rst:1
msgid "reencode"
msgstr "reencode"

#: ../../source/cli.rst:1
msgid "Réécrit les analyses au format compact."
msgstr "Reescribe los análisis en el formato compacto."

#: ../../source/cli.rst:1
msgid "repair"
msgstr "repair"

#: ../../source/cli.rst:1
