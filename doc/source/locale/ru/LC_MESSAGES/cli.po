msgstr ""
"Вычисляет Effective Pip Count и вердикт по кубу для позиции выброса "
"(XGID)."

#: ../../source/cli.rst:1
msgid "analyze"
msgstr "analyze"

#: ../../source/cli.rst:1
msgid "Écrit une analyse gammonNet pour chaque position qui n'en a aucune."
msgstr "Записывает анализ gammonNet для каждой позиции, у которой его нет."

#: ../../source/cli.rst:1
msgid "info"
msgstr "info"

#: ../../source/cli.rst:1
msgid "Affiche les métadonnées de la base."
msgstr "Отобразить метаданные базы."

#: ../../source/cli.rst:1
msgid "edit"
msgstr "edit"

#: ../../source/cli.rst:1
msgid "Modifie les métadonnées de la base."
msgstr "Изменить метаданные базы."

#: ../../source/cli.rst:1
msgid "verify"
msgstr "verify"

#: ../../source/cli.rst:1
msgid "Vérifie l'intégrité de la base."
msgstr "Проверить целостность базы."

#: ../../source/cli.rst:1
msgid "vacuum"
msgstr "vacuum"

#: ../../source/cli.rst:1
msgid "Compacte le fichier de base de données, récupère l'espace libéré."
msgstr "Сжимает файл базы данных, возвращая освободившееся место."

#: ../../source/cli.rst:1
msgid "delete"
msgstr "delete"

#: ../../source/cli.rst:1
