#: ../../source/cli_admin.rst:1
msgid "``analysis.missing``"
msgstr "``analysis.missing``"

#: ../../source/cli_admin.rst:1
msgid "Positions sans aucune analyse, à la demande."
msgstr "Позиции без какого-либо анализа, по запросу."

#: ../../source/cli_admin.rst:1
msgid "La commande ``analyze``."
msgstr "Команда ``analyze``."

#: ../../source/cli_admin.rst:1
msgid "``stats.matches``"
msgstr "``stats.matches``"

#: ../../source/cli_admin.rst:1
msgid "Matchs sans statistiques par match."
msgstr "Матчи без статистики по матчу."

#: ../../source/cli_admin.rst:1
msgid "Les calcule."
msgstr "Вычисляет её."

#: ../../source/cli_admin.rst:1
