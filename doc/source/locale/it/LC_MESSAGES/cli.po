msgid "Recherche des positions avec filtres."
msgstr "Cerca posizioni con filtri."

#: ../../source/cli.rst:1
msgid "list"
msgstr "list"

#: ../../source/cli.rst:1
msgid "Affiche le contenu de la base."
msgstr "Mostra il contenuto del database."

#: ../../source/cli.rst:1
msgid "match"
msgstr "match"

#: ../../source/cli.rst:1
msgid "Affiche les positions et analyses d'un match."
msgstr "Mostra le posizioni e le analisi di un match."

#: ../../source/cli.rst:1
msgid "transcribe"
msgstr "transcribe"

#: ../../source/cli.rst:1
msgid "Rejoue une transcription et rend compte de ce que le rejeu trouve."
msgstr "Riesegue una trascrizione e riferisce ciò che il rigioco trova."

#: ../../source/cli.rst:1
msgid "duel"
msgstr "duel"

#: ../../source/cli.rst:1
msgid ""
"Joue un Duel une Action par appel (création, coup, videau, abandon, "
"arrêt)."
msgstr ""
"Gioca un Duello, un'Azione per chiamata (creazione, mossa, cubo, "
"abbandono, arresto)."

#: ../../source/cli.rst:1
msgid "collection"
msgstr "collection"

