#: ../../source/cli.rst:1
msgid "events"
msgstr "events"

#: ../../source/cli.rst:1
msgid "Les graphies d'un événement (alias)."
msgstr "Le grafie di un evento (alias)."

#: ../../source/cli.rst:1
msgid "trash"
msgstr "trash"

#: ../../source/cli.rst:1
msgid "La corbeille : liste, restauration, suppression annulable."
msgstr "Il cestino: elenco, ripristino, eliminazione annullabile."

#: ../../source/cli.rst:1
msgid "info"
msgstr "info"

#: ../../source/cli.rst:1
msgid "Affiche les métadonnées de la base."
msgstr "Mostra i metadati del database."

#: ../../source/cli.rst:1
msgid "edit"
msgstr "edit"

#: ../../source/cli.rst:1
msgid "Modifie les métadonnées et les seuils de la base."
msgstr "Modifica i metadati e le soglie del database."

#: ../../source/cli.rst:1
msgid "verify"
msgstr "verify"

#: ../../source/cli.rst:1
msgid "Vérifie l'intégrité de la base."
msgstr "Verifica l'integrità del database."

#: ../../source/cli.rst:1
msgid "vacuum"
msgstr "vacuum"

#: ../../source/cli.rst:1
msgid "Compacte le fichier de base de données, récupère l'espace libéré."
msgstr "Compatta il file del database, recuperando lo spazio liberato."

#: ../../source/cli.rst:1
msgid "met"
msgstr "met"

#: ../../source/cli.rst:1
msgid "Liste, importe et choisit la table d'équité de match de la base."
msgstr "Elenca, importa e sceglie la tabella di equity di match del database."

#: ../../source/cli.rst:1
msgid "reencode"
msgstr "reencode"

#: ../../source/cli.rst:1
