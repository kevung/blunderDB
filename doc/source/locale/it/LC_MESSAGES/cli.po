msgid ""
"Affiche ou déplace l'identité d'émetteur (clé de signature des "
"filigranes)."
msgstr "Mostra o sposta l'identità di emittente (chiave di firma delle filigrane)."

#: ../../source/cli.rst:1
msgid "open"
msgstr "open"

#: ../../source/cli.rst:1
msgid "Transforme un fichier protégé par mot de passe (.dbx) en base ordinaire."
msgstr "Trasforma un file protetto da password (.dbx) in un database ordinario."

#: ../../source/cli.rst:1
msgid "search"
msgstr "search"

