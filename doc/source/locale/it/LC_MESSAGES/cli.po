msgstr "Genera, elenca, verifica ed elimina i database di uscita."

#: ../../source/cli.rst:1
msgid "analyze"
msgstr "analyze"

#: ../../source/cli.rst:1
msgid "Écrit une analyse gammonNet pour chaque position qui n'en a aucune."
