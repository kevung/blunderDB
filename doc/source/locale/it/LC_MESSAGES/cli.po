msgstr "Codici di uscita"

#: ../../source/cli.rst:1535
msgid "``0`` — Succès."
msgstr "``0`` — Successo."

#: ../../source/cli.rst:1536
msgid "``1`` — Erreur."
msgstr "``1`` — Errore."

