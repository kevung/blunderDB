#: ../../source/cli.rst:172
msgid "Exporte le contenu de la base vers des fichiers."
msgstr "Esporta il contenuto del database in file."

#: ../../source/cli.rst:180
msgid "``--db`` — Base source (obligatoire)."
msgstr "``--db`` — Database di origine (obbligatorio)."

#: ../../source/cli.rst:181
msgid ""
"``--type`` — Type d'export: ``database``, ``positions``, ``matches`` ou "
