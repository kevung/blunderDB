#: ../../source/cli.rst:1
msgid "tournament"
msgstr "tournament"

#: ../../source/cli.rst:1
msgid ""
"Lit un tournoi dirigé (classement, tableaux, pages) et confirme ses "
"propositions."
msgstr ""
"Legge un torneo diretto (classifica, tabelloni, pagine) e conferma le sue"
" proposte."

#: ../../source/cli.rst:1
msgid "players"
msgstr "players"

#: ../../source/cli.rst:1
msgid "Les graphies d'un joueur (alias), la fusion et l'inversion des joueurs."
msgstr ""
"Le grafie di un giocatore (alias), la fusione e l'inversione dei "
