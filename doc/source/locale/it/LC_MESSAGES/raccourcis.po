msgid "Copier l'image du board avec l'analyse dans le presse-papier (PNG)."
msgstr "Copia l'immagine del board con l'analisi negli appunti (PNG)."

#: ../../source/raccourcis.rst:1
msgid "CTRL-V"
msgstr "CTRL-V"

#: ../../source/raccourcis.rst:1
msgid ""
"Coller une position depuis le presse-papier (détection automatique du "
"format)."
msgstr "Incolla una posizione dagli appunti (rilevamento automatico del formato)."

#: ../../source/raccourcis.rst:1
msgid "CTRL-S"
msgstr "CTRL-S"

#: ../../source/raccourcis.rst:1
msgid "Enregistrer une position."
msgstr "Salva una posizione."

#: ../../source/raccourcis.rst:1
msgid "CTRL-U"
msgstr "CTRL-U"

#: ../../source/raccourcis.rst:1
msgid "Mettre à jour une position."
msgstr "Aggiorna una posizione."

#: ../../source/raccourcis.rst:1
msgid "Del"
msgstr "Canc"

#: ../../source/raccourcis.rst:1
msgid "Supprimer la position courante (confirmation demandée)."
msgstr "Elimina la posizione corrente (viene chiesta conferma)."

