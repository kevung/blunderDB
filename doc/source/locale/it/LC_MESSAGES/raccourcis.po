#: ../../source/raccourcis.rst:26
msgid "Position"
msgstr "Posizione"

#: ../../source/raccourcis.rst:1
msgid "CTRL-I"
msgstr "CTRL-I"

#: ../../source/raccourcis.rst:1
msgid ""
"Importer une ou plusieurs positions/matchs par fichier (xg, xgp, sgf, "
"mat, txt, bgf)."
msgstr "Importa una o più posizioni/partite da file (xg, xgp, sgf, mat, txt, bgf)."

#: ../../source/raccourcis.rst:1
msgid "CTRL-SHIFT-F"
msgstr "CTRL-SHIFT-F"

#: ../../source/raccourcis.rst:1
msgid "Importer récursivement un dossier de fichiers de matchs/positions."
msgstr "Importa ricorsivamente una cartella di file di partite/posizioni."

#: ../../source/raccourcis.rst:1
msgid "CTRL-C"
msgstr "CTRL-C"

