#: ../../source/raccourcis.rst:1
msgid "Supprimer le match sélectionné."
msgstr "Διαγραφή του επιλεγμένου αγώνα."

#: ../../source/raccourcis.rst:1
msgid "Désélectionner/fermer le panneau."
msgstr "Αποεπιλογή/κλείσιμο του πίνακα."

#: ../../source/raccourcis.rst:223
msgid "Panneau Anki (répétition espacée)"
msgstr "Πίνακας Anki (επαναληπτική μελέτη με χρονικά διαστήματα)"

#: ../../source/raccourcis.rst:1
msgid "ESPACE, Clic"
msgstr "ΔΙΑΣΤΗΜΑ, Κλικ"

#: ../../source/raccourcis.rst:1
msgid "Afficher la réponse (l'analyse enregistrée de la position)."
msgstr "Εμφάνιση της απάντησης (της καταγεγραμμένης ανάλυσης της θέσης)."

#: ../../source/raccourcis.rst:1
msgid "1"
msgstr "1"

#: ../../source/raccourcis.rst:1
msgid "Évaluer : À revoir (échec, revoir bientôt)."
msgstr "Αξιολόγηση: Ξανά (αποτυχία, επανάληψη σύντομα)."

#: ../../source/raccourcis.rst:1
msgid "2"
msgstr "2"

#: ../../source/raccourcis.rst:1
msgid "Évaluer : Difficile."
msgstr "Αξιολόγηση: Δύσκολο."

#: ../../source/raccourcis.rst:1
msgid "3"
msgstr "3"

#: ../../source/raccourcis.rst:1
msgid "Évaluer : Bien."
msgstr "Αξιολόγηση: Καλό."

#: ../../source/raccourcis.rst:1
msgid "4"
msgstr "4"

#: ../../source/raccourcis.rst:1
msgid "Évaluer : Facile."
msgstr "Αξιολόγηση: Εύκολο."

#: ../../source/raccourcis.rst:1
msgid ""
"Afficher/cacher le compte de course (identique au raccourci général, "
"disponible pendant la révision)."
msgstr ""
"Εμφάνιση/απόκρυψη του pip count (ίδιο με τη γενική συντόμευση, διαθέσιμο "
"κατά την επανάληψη)."

#: ../../source/raccourcis.rst:1
msgid "Arrêter la révision et revenir à la liste des paquets (reprise possible)."
msgstr ""
"Διακοπή της επανάληψης και επιστροφή στη λίστα πακέτων (δυνατότητα "
"συνέχισης αργότερα)."

#: ../../source/raccourcis.rst:241
msgid "Panneau des tournois"
msgstr "Πίνακας τουρνουά"

#: ../../source/raccourcis.rst:1
msgid "Clic, Double-clic"
msgstr "Κλικ, Διπλό κλικ"

#: ../../source/raccourcis.rst:1
msgid "Sélectionner un tournoi (afficher son détail)."
msgstr "Επιλογή τουρνουά (εμφάνιση των λεπτομερειών του)."

#: ../../source/raccourcis.rst:1
msgid "Sélectionner le tournoi précédent."
msgstr "Επιλογή του προηγούμενου τουρνουά."

#: ../../source/raccourcis.rst:1
msgid "Sélectionner le tournoi suivant."
