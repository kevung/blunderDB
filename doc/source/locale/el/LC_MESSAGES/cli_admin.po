#: ../../source/cli_admin.rst:4
msgid "Administration de la base"
msgstr "Διαχείριση της βάσης δεδομένων"

#: ../../source/cli_admin.rst:7
msgid "info — Métadonnées de la base"
msgstr "info — Μεταδεδομένα της βάσης"

#: ../../source/cli_admin.rst:9
msgid "Affiche les métadonnées et les statistiques d'une base de données."
msgstr "Εμφανίζει τα μεταδεδομένα και τα στατιστικά μιας βάσης δεδομένων."

#: ../../source/cli_admin.rst:15 ../../source/cli_admin.rst:102
#: ../../source/cli_admin.rst:136 ../../source/cli_admin.rst:272
#: ../../source/cli_admin.rst:317 ../../source/cli_admin.rst:357
