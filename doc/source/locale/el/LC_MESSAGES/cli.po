#: ../../source/cli.rst:1
msgid "vacuum"
msgstr "vacuum"

#: ../../source/cli.rst:1
msgid "Compacte le fichier de base de données, récupère l'espace libéré."
msgstr "Συμπυκνώνει το αρχείο της βάσης, ανακτώντας τον ελεύθερο χώρο."

#: ../../source/cli.rst:1
msgid "repair"
msgstr "repair"

#: ../../source/cli.rst:1
msgid "Recalcule ce que la base dérive de ce qu'elle stocke."
msgstr "Επανυπολογίζει ό,τι η βάση παράγει από όσα αποθηκεύει."

#: ../../source/cli.rst:1
