msgid ""
"Gère les collections (liste, contenu, création, renommage, suppression, "
"export)."
msgstr ""
"Διαχειρίζεται τις συλλογές (λίστα, περιεχόμενο, δημιουργία, μετονομασία, "
"διαγραφή, εξαγωγή)."

#: ../../source/cli.rst:1
msgid "anki"
msgstr "anki"

#: ../../source/cli.rst:1
msgid ""
"Paquets de répétition espacée (liste, statistiques, prévision, "
"synchronisation)."
msgstr ""
"Πακέτα επανάληψης με διαστήματα (λίστα, στατιστικά, πρόβλεψη, "
"συγχρονισμός)."

#: ../../source/cli.rst:1
msgid "epc"
msgstr "epc"

#: ../../source/cli.rst:1
