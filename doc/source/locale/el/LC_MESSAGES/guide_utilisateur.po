#: ../../source/guide_utilisateur.rst:506
msgid ""
"des dossiers pour importer récursivement tous les fichiers qu'ils "
"contiennent."
msgstr "φακέλους για να εισαγάγετε αναδρομικά όλα τα αρχεία που περιέχουν."

#: ../../source/guide_utilisateur.rst:509
msgid "Naviguer dans un match"
msgstr "Πλοήγηση σε έναν αγώνα"

