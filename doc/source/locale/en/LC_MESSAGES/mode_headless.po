msgstr "``--to <dsn>``"

#: ../../source/mode_headless.rst:702
msgid "DSN PostgreSQL de destination (``postgres://…``)"
msgstr "destination PostgreSQL DSN (``postgres://…``)"

#: ../../source/mode_headless.rst:703
msgid "``--tenant-id <n>``"
msgstr "``--tenant-id <n>``"

#: ../../source/mode_headless.rst:705
msgid ""
"tenant de destination, un entier décimal positif (obligatoire sauf en "
"``--dry-run`` ; un nom comme ``mon-tenant`` est refusé)"
msgstr ""
"destination tenant, a positive decimal integer (required except in "
"``--dry-run``; a name such as ``mon-tenant`` is refused)"

#: ../../source/mode_headless.rst:707
