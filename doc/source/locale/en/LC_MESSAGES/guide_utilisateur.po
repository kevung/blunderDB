#: ../../source/guide_utilisateur.rst:702
msgid "**Créer un tournoi:**"
msgstr "**Create a tournament:**"

#: ../../source/guide_utilisateur.rst:704
msgid "Ouvrir le panneau des tournois (*CTRL-Y*)."
msgstr "Open the tournaments panel (*CTRL-Y*)."

#: ../../source/guide_utilisateur.rst:706
