#~ msgid "mcp — Offrir la base à un assistant IA"
#~ msgstr "mcp — Offer the database to an AI assistant"

#~ msgid ""
#~ "Sert les outils de la base à "
#~ "un assistant IA par le *Model "
#~ "Context Protocol*, sur l'entrée et la"
#~ " sortie standard : c'est l'assistant "
#~ "qui lance la commande. Les outils "
#~ "recherchent des positions dans la "
#~ "grammaire de la barre de commande, "
#~ "lisent une position et son analyse, "
#~ "expliquent une erreur, calculent les "
#~ "statistiques d'un joueur, listent matchs, "
#~ "tournois et collections, et posent un"
#~ " quiz. Ils ne font que lire, "
#~ "sauf avec ``--write``. La liste complète"
#~ " et l'équivalent HTTP du démon : "
#~ ":ref:`headless_mcp`."
#~ msgstr ""
#~ "Serves the database tools to an AI"
#~ " assistant through the *Model Context "
#~ "Protocol*, over standard input and "
#~ "output: the assistant launches the "
#~ "command. The tools search positions in"
#~ " the command-bar grammar, read a "
#~ "position and its analysis, explain an"
#~ " error, compute a player's statistics, "
#~ "list matches, tournaments and collections, "
#~ "and ask a quiz question. They only"
#~ " read, except with ``--write``. The "
#~ "full list and the daemon's HTTP "
#~ "equivalent: :ref:`headless_mcp`."

#~ msgid "``--db`` — Fichier de base de données (obligatoire)."
#~ msgstr "``--db`` — Database file (required)."

#~ msgid ""
#~ "``--write`` — Offre aussi les outils "
#~ "qui écrivent : enregistrer une position,"
#~ " la commenter, créer et remplir une"
#~ " collection. Rien n'efface."
#~ msgstr ""
#~ "``--write`` — Also offers the tools "
#~ "that write: save a position, comment "
#~ "it, create and fill a collection. "
#~ "Nothing is deleted."

