#~ msgstr ""
#~ "``evaluate --id <id> [--limit <n>] "
#~ "[--format text|json]`` — Reads the "
#~ "position identifiers of a collection, "
#~ "replaying the query of a living "
#~ "collection now. The response is bounded"
