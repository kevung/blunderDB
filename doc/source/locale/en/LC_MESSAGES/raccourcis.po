msgstr "Stop the review and return to the deck list (can resume later)."

#: ../../source/raccourcis.rst:238
msgid "Panneau des tournois"
msgstr "Tournament Panel"

#: ../../source/raccourcis.rst:1
msgid "Clic, Double-clic"
msgstr "Click, Double-click"

#: ../../source/raccourcis.rst:1
msgid "Sélectionner un tournoi (afficher son détail)."
msgstr "Select a tournament (show its detail)."

#: ../../source/raccourcis.rst:1
msgid "Sélectionner le tournoi précédent."
msgstr "Select previous tournament."

#: ../../source/raccourcis.rst:1
msgid "Sélectionner le tournoi suivant."
msgstr "Select next tournament."

#: ../../source/raccourcis.rst:1
msgid "Double-clic (sur un match du tournoi)"
